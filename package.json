{
  "name": "context-compiler-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "RippleContext: local, model-independent context state and recall service exposed over MCP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "context-compiler-mcp": "dist/mcp-server.js",
    "context-compiler-eval": "dist/evaluation-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "evaluation/session-scope-broad-keyword.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "evaluate": "npm run build && node dist/evaluation-cli.js",
    "test": "vitest run test",
    "test:protocol": "vitest run test/mcp-protocol.test.ts",
    "benchmark:session-scope": "npm run build && node evaluation/session-scope-broad-keyword.mjs",
    "verify:query-artifact": "node validation/query-artifact.mjs",
    "start": "node dist/mcp-server.js",
    "prepack": "npm run build && npm run verify:query-artifact"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
