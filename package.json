{
  "name": "context-compiler-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, model-independent context state and recall service exposed over MCP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "context-compiler-mcp": "dist/mcp-server.js",
    "context-compiler-eval": "dist/evaluation-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "evaluate": "npm run build && node dist/evaluation-cli.js",
    "test": "vitest run test",
    "test:protocol": "vitest run test/mcp-protocol.test.ts",
    "start": "node dist/mcp-server.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
