    {"id":"STR-07/E1","segment_id":"STR-07","ordinal":1,"role":"user","event_type":"issue_body","source":{"source_id":"gh:issue:1008","kind":"issue","repository":"Kludex/starlette","number":1008,"database_id":"664629026","node_id":"MDU6SXNzdWU2NjQ2MjkwMjY=","url":"https://github.com/Kludex/starlette/issues/1008","commit_sha":null},"occurred_at":"2020-07-23T16:55:59Z","source_updated_at":"2020-09-30T03:52:35Z","actor":"curtiscook","summary":"The issue reports that after upgrading, a route path ending in /? no longer serves both the empty and slash root variants and now returns 404.","source_content_sha256":"e114337b8d296fb0a16bba8f7b296a8bb277ffc7add026ae98874c2272b287d8"},
