{
  "schema_version": "rc-synth-long-stage-plan/1.1.0",
  "contract_version": "rc-synth-long-contract/1.0.0-draft.3",
  "task_isolation": {
    "one_long_lived_task_for_all_stages_allowed": false,
    "fresh_task_per_stage_required": true,
    "fresh_task_per_chapter_required": true,
    "fresh_answer_blind_task_per_query_cutoff_group_required": true,
    "prior_full_corpus_in_generation_input_allowed": false,
    "stage_handoff_manifest_required": true
  },
  "generation_repair_policy": {
    "initial_attempts_per_chapter": 1,
    "maximum_mechanical_repair_attempts_per_chapter": 1,
    "best_of_allowed": false,
    "candidate_selection_allowed": false,
    "original_failed_output_eligible": false,
    "same_model_reasoning_prompt_and_generator_required": true,
    "only_prompt_addition": "machine-verifiable failure diagnostics",
    "allowed_reasons": ["TRUNCATION", "SCHEMA_FORMAT_FAILURE", "MISSING_PREREGISTERED_EVENT_SURFACE", "CHARACTER_BOUND_VIOLATION", "SURFACE_ANCHOR_FAILURE"],
    "semantic_inconsistency_action": "INVALIDATE_CORPUS_VERSION_AND_FRESH_REGENERATE_AFFECTED_CHAPTERS_AND_DEPENDENTS"
  },
  "stages": [
    {
      "ordinal": 1,
      "stage": "SPEC",
      "task_ids": ["SPEC-01"],
      "execution": "MODEL",
      "model": "gpt-5.6-sol",
      "reasoning": "high",
      "planned_model_calls": 1,
      "inputs": ["AGENTS.md", "docs/PROJECT_STATE.md", "docs/ROADMAP.md", "WO-BM-01 routed references"],
      "outputs": ["docs/benchmarks/ripplecontext-long-v1-spec.md", "evaluation/ripplecontext-long-v1/spec/**", "docs/handoffs/WO-BM-01.md"],
      "allowed_write_roots": ["docs/benchmarks", "docs/work-orders", "docs/handoffs", "evaluation/ripplecontext-long-v1/spec"],
      "forbidden_outputs": ["world instance", "event instance", "Gold instance", "query-plan instance", "query instance", "corpus prose", "evaluator result"],
      "pass_condition": "Independent QA accepts contract, eight schemas, taxonomy, chapter plan, stage plan, cost plan, and zero downstream artifacts.",
      "stop_conditions": ["missing acceptance criterion", "schema parse failure", "Core or frozen artifact drift"]
    },
    {
      "ordinal": 2,
      "stage": "WORLD",
      "task_ids": ["WORLD-01-ENTITIES", "WORLD-02-TIMELINES"],
      "execution": "MODEL",
      "model": "gpt-5.6-sol",
      "reasoning": "medium",
      "planned_model_calls": 2,
      "inputs": ["frozen SPEC", "chapter-plan.json"],
      "outputs": ["world/world-bible.json", "world/style-bible.json", "world/alias-name-registry.json", "world/entities.json", "world/characters.json", "world/locations.json", "world/chapter-event-slot-map.json"],
      "allowed_write_roots": ["datasets/<dataset_id>/world", "datasets/<dataset_id>/stage-handoffs/WORLD"],
      "forbidden_outputs": ["canonical events", "Gold", "query plan", "query text", "corpus prose"],
      "pass_condition": "World and immutable style/name controls satisfy entity, track, long-range, and chapter denominators without canonical answer generation.",
      "stop_conditions": ["Sol unavailable", "reasoning medium unavailable", "world contradicts SPEC", "coverage denominators cannot be met"]
    },
    {
      "ordinal": 3,
      "stage": "GOLD",
      "task_ids": ["GOLD-01-EVENT-GRAPH", "GOLD-02-STATE-FACT-RELATION", "GOLD-03-QUERY-ORACLES-AND-PLAN"],
      "execution": "MODEL",
      "model": "gpt-5.6-sol",
      "reasoning": "medium",
      "planned_model_calls": 3,
      "inputs": ["frozen SPEC", "frozen WORLD", "events/gold/query-plan/timeline schemas"],
      "outputs": ["evaluator-control/events.json", "evaluator-control/timeline.json", "evaluator-control/gold.json", "evaluator-control/query-plan.json", "world/chapter-event-plans/CH001.json..CH040.json"],
      "allowed_write_roots": ["datasets/<dataset_id>/evaluator-control", "datasets/<dataset_id>/world/chapter-event-plans", "datasets/<dataset_id>/stage-handoffs/GOLD"],
      "forbidden_outputs": ["final natural-language query text", "corpus prose", "model answers", "evaluation result"],
      "pass_condition": "Events, timeline, evaluator-control Gold, query plan, and chapter event plans validate and are hash-frozen before GENERATION.",
      "stop_conditions": ["Sol unavailable", "reasoning medium unavailable", "non-zero denominator missing", "unresolved ID", "control assets cannot be frozen"]
    },
    {
      "ordinal": 4,
      "stage": "GENERATION",
      "task_ids": ["GEN-CH001..GEN-CH040"],
      "execution": "MODEL",
      "model": "gpt-5.6-terra",
      "reasoning": "low_or_preregistered_medium",
      "planned_initial_model_calls": 40,
      "planned_repair_model_calls_default": 0,
      "maximum_repair_model_calls": 40,
      "planned_low_initial_calls": 28,
      "planned_medium_initial_calls": 12,
      "inputs": ["frozen world bible", "immutable style bible", "alias/name registry", "current local entity state", "current relation/state snapshot", "unresolved clue/open-thread ledger", "one chapter event plan", "bounded necessary-prior summary", "zero to two necessary prior exact-text snippets", "opaque future-event IDs and negative constraints", "continuity bundle"],
      "outputs": ["one corpus/chapters/CHxxx.md per task", "generation surface-anchor sidecar", "attempt call ledger entries", "one chapter handoff manifest", "one immutable continuity bundle"],
      "allowed_write_roots": ["datasets/<dataset_id>/corpus/chapters", "datasets/<dataset_id>/generation", "datasets/<dataset_id>/stage-handoffs/GENERATION", "datasets/<dataset_id>/validation/invalid-runs.jsonl"],
      "forbidden_inputs": ["prior full corpus", "future chapter plan", "query plan", "query oracle", "evaluator-control Gold", "comparator answers", "future-event payload"],
      "forbidden_outputs": ["Gold edit", "event graph edit", "query-plan edit", "query text", "best-of candidates"],
      "pass_condition": "All forty chapters have one eligible output after the initial attempt or at most one recorded mechanical repair, with no candidate selection and frozen authority unchanged.",
      "stop_conditions": ["Terra unavailable", "required reasoning unavailable", "second mechanical failure", "semantic inconsistency", "rate-limit exhaustion", "tool failure", "unregistered repair"],
      "fallback": "NONE_STOP_AND_REPORT"
    },
    {
      "ordinal": 5,
      "stage": "SURFACE_MAPPING_BASE_VALIDATION",
      "task_ids": ["MAP-01"],
      "execution": "DETERMINISTIC",
      "model": "NONE",
      "reasoning": "NONE",
      "planned_model_calls": 0,
      "inputs": ["frozen evaluator-control assets", "eligible corpus chapters", "generation surface-anchor sidecars", "continuity bundles", "attempt ledgers"],
      "outputs": ["derived/surface-evidence-map.jsonl", "validation/surface-mapping-report.json", "derived/prefixes-by-cutoff-group/**"],
      "allowed_write_roots": ["datasets/<dataset_id>/derived", "datasets/<dataset_id>/validation", "datasets/<dataset_id>/stage-handoffs/SURFACE_MAPPING_BASE_VALIDATION"],
      "forbidden_outputs": ["authority edit", "corpus edit", "query text", "model call"],
      "pass_condition": "Every required event and semantic unit is bound to exact eligible corpus bytes with verified document/text hashes and Unicode-codepoint half-open spans; cutoff prefixes reconstruct exactly.",
      "stop_conditions": ["unmapped required evidence", "span/hash mismatch", "event or semantic endpoint missing", "invalid chapter selected", "future leakage in prefix"]
    },
    {
      "ordinal": 6,
      "stage": "QUERY_SURFACING",
      "task_ids": ["QS-QCG01..QS-QCG12"],
      "execution": "MODEL",
      "model": "gpt-5.6-sol",
      "reasoning": "medium",
      "planned_model_calls": 12,
      "inputs": ["transient deterministic safe envelope containing only query_id + frozen answer-neutral query_surface_brief + brief hash", "exact corpus prefix bytes visible at one frozen cutoff"],
      "outputs": ["queries/queries.json query_text records", "one answer-blind call ledger entry with safe-envelope hash per cutoff group"],
      "allowed_write_roots": ["datasets/<dataset_id>/queries", "datasets/<dataset_id>/stage-handoffs/QUERY_SURFACING", "datasets/<dataset_id>/validation/invalid-runs.jsonl"],
      "forbidden_inputs": ["raw query plan", "query oracle", "evaluator-control Gold", "cutoff-after corpus", "future events", "expected answer semantics or current truth", "expected action or abstention conclusion", "required or forbidden evidence labels", "case or failure scoring labels", "answer-bearing spans"],
      "forbidden_outputs": ["query-plan edit", "oracle edit", "cutoff edit", "case or facet edit", "corpus edit"],
      "pass_condition": "Each final query text is generated from only its hashed safe brief and visible prefix, preserves the brief's subject/information need/as-of view/output shape, links one-to-one to the frozen plan, and passes structural and leakage checks plus semantic review.",
      "stop_conditions": ["Sol unavailable", "reasoning medium unavailable", "raw control asset read", "safe-envelope hash mismatch", "brief subject or alias not visible by cutoff", "future-prefix read", "answer or evidence leakage", "information-need drift"]
    },
    {
      "ordinal": 7,
      "stage": "MECHANICAL_VALIDATION",
      "task_ids": ["MECH-01"],
      "execution": "DETERMINISTIC_WITH_OPTIONAL_MODEL_EXCEPTION",
      "model": "NONE",
      "reasoning": "NONE",
      "planned_model_calls": 0,
      "optional_exception_model": "gpt-5.6-luna",
      "optional_exception_reasoning": "low",
      "optional_exception_call_cap": 8,
      "inputs": ["frozen contract/world/evaluator-control/query assets", "all eligible corpus chapters", "surface evidence map", "all call ledgers"],
      "outputs": ["validation/mechanical-report.json", "validation/coverage-report.json", "derived/prefixes/**"],
      "allowed_write_roots": ["datasets/<dataset_id>/validation", "datasets/<dataset_id>/derived/prefixes", "datasets/<dataset_id>/stage-handoffs/MECHANICAL_VALIDATION"],
      "forbidden_outputs": ["source asset edit", "Gold edit", "corpus edit", "automatic fix"],
      "pass_condition": "Every deterministic cross-file, lifecycle, mapping, cutoff, query-surface, attempt, hash, coverage, and cost invariant passes; any Luna exception is preregistered and separately recorded.",
      "stop_conditions": ["any deterministic failure", "Luna required but unavailable", "Luna cap exceeded", "unregistered model call"],
      "fallback": "NONE_STOP_AND_REPORT"
    },
    {
      "ordinal": 8,
      "stage": "SEMANTIC_AUDIT",
      "task_ids": ["AUDIT-01-LIFECYCLE", "AUDIT-02-FACT-RELATION", "AUDIT-03-MULTIFACET-LEAKAGE", "AUDIT-04-SYNTHESIS"],
      "execution": "MODEL",
      "model": "gpt-5.6-sol",
      "reasoning": "high",
      "planned_model_calls": 4,
      "qualification": "BUILDER_SIDE_CONSISTENCY_AUDIT_NOT_INDEPENDENT_QA",
      "inputs": ["preregistered sample plan", "critical chain slices", "relevant evaluator-control Gold only", "relevant corpus units only", "surface evidence map slices", "mechanical reports"],
      "outputs": ["audit/sample-plan.json", "audit/semantic-audit.json", "stage-handoffs/SEMANTIC_AUDIT/**"],
      "allowed_write_roots": ["datasets/<dataset_id>/audit", "datasets/<dataset_id>/stage-handoffs/SEMANTIC_AUDIT", "datasets/<dataset_id>/validation/invalid-runs.jsonl"],
      "forbidden_inputs": ["entire corpus in one audit call", "comparator answers"],
      "forbidden_outputs": ["Gold edit", "corpus edit", "regenerated prose", "Independent QA approval"],
      "pass_condition": "Critical chains, negative-transfer pairs, long-range pairs, multi-facet cases, query surfaces, and the stratified chapter sample have no material semantic mismatch or answer leakage.",
      "stop_conditions": ["Sol unavailable", "reasoning high unavailable", "material mismatch", "future leakage", "answer hint in corpus or query surface"]
    },
    {
      "ordinal": 9,
      "stage": "FREEZE",
      "task_ids": ["FREEZE-01"],
      "execution": "DETERMINISTIC",
      "model": "NONE",
      "reasoning": "NONE",
      "planned_model_calls": 0,
      "inputs": ["all passed stage manifests", "all frozen dataset files", "exact model/attempt call ledger", "prompt/generator versions"],
      "outputs": ["manifest.json", "freeze/hashes.json", "freeze/hashes.sha256", "freeze/manifest.sha256"],
      "allowed_write_roots": ["datasets/<dataset_id>/manifest.json", "datasets/<dataset_id>/freeze", "datasets/<dataset_id>/stage-handoffs/FREEZE"],
      "forbidden_outputs": ["any content mutation", "model call", "evaluation result"],
      "pass_condition": "Independent deterministic reconstruction matches every SHA-256, coverage count, version binding, attempt ledger, and generation-call total.",
      "stop_conditions": ["pending or failed gate", "hash mismatch", "unlisted file", "model identity missing", "invalid run"]
    }
  ]
}
